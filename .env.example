# === LLM (Groq) ===
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=llama-3.1-8b-instant

# === Database ===
# Local dev: leave blank (defaults to SQLite). Prod: Supabase Postgres connection string.
DATABASE_URL=

# === Supabase Auth ===
# From Supabase dashboard → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=
# From Supabase dashboard → Project Settings → API → Project URL
SUPABASE_URL=

# === Feature flags ===
# Set to true to enable POST /ml/train-categorizer in production
ADMIN_ENABLED=false
# Set to true on Cloud Run to run Alembic migrations at startup
RUN_MIGRATIONS_ON_STARTUP=false

# === CORS ===
# Comma-separated list of allowed origins for production (e.g. https://your-app.vercel.app)
# Leave blank in local dev — localhost:3000 and localhost:5173 are included automatically
CORS_ALLOWED_ORIGINS=
